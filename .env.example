# Discord
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
GUILD_ID=your_discord_server_id

# ——— Website relay ———
WEBSITE_INGEST_URL=https://acesrust.com/api/discord/ingest
WEBSITE_API_SECRET=your_shared_secret
WEBSITE_LEADERBOARD_URL=
BOT_WEBHOOK_SECRET=your_webhook_secret
BOT_WEBHOOK_PORT=3847
ADMIN_PANEL_PASSWORD=change-me
# Optional: separate HMAC secret for panel session cookies (recommended)
ADMIN_SESSION_SECRET=
# Public admin URL (used in logs). Point DNS at Railway, e.g. admin.astralrce.com
ADMIN_PANEL_URL=https://admin.astralrce.com
# Where links/kits/stats are stored. On Railway mount a volume here (default /app/.data).
DATA_DIR=
# Optional logo override for Discord panels. Leave empty to use the bundled
# assets/astral-logo.png (also served at /logo.png).
BRAND_LOGO_URL=

# ——— Relay channels ———
CHANNEL_LEADERBOARD=
CHANNEL_KAOS_ACTIVITY=
POP_CHANNEL_ID=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_WIPES=
CHANNEL_EVENTS=

# ——— Community / mod channels ———
CHANNEL_MOD_LOG=
# Ticket open/close + transcripts (falls back to CHANNEL_MOD_LOG if empty)
CHANNEL_TICKET_LOG=
CHANNEL_WELCOME=
CHANNEL_STAFF_ALERT=
CATEGORY_TICKETS=

# ——— Roles ———
ROLE_STAFF_IDS=123456789,987654321
ROLE_VERIFIED=
ROLE_VIP=
ROLE_AUTO_MEMBER=

# ——— Giveaways ———
GIVEAWAY_MIN_ACCOUNT_DAYS=1
GIVEAWAY_MIN_JOIN_HOURS=1
# ——— Auto-mod ———
AUTOMOD_ENABLED=true
MIN_ACCOUNT_DAYS=0
MIN_JOIN_HOURS=0
LINK_ALLOWLIST=acesrust.com,tip4serv.com
ALLOW_DISCORD_INVITES=false
WORD_FILTER=
RAID_JOIN_THRESHOLD=8
RAID_WINDOW_SECONDS=15
AUTO_MUTE_AFTER_WARNS=3
AUTO_MUTE_MINUTES=60

# ——— Rust server (RCON) ———
# Nitrado → server settings → WebRCON
# HOST = IP only (no port). PORT = RCON port only (e.g. 25800).
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
RCON_SERVER_NAME=astral
RCON_CHAT_BRIDGE=false
RCON_INGAME_KILLFEED=false
RCON_LEADERBOARD_PUSH_MS=120000
RCON_STATUS_UPDATE_MS=120000

# ——— Rust Map (for Live Map feature) ———
# Get from Nitrado → Settings → World Seed and World Size
RUST_MAP_SEED=
RUST_MAP_SIZE=4000
# Best for Console: upload a map screenshot in the admin Live Map tab
# (saved to .data/maps). Or set a direct image URL:
RUST_MAP_IMAGE_URL=
# PC only — Console maps do NOT match. Off unless you set RUSTMAPS_ENABLE=true
RUSTMAPS_API_KEY=
RUSTMAPS_ENABLE=false

# ——— In-game feed channels ———
# Prefer setting these in the admin panel → Server Commands tab.
# Panel values override .env and are stored in .data/settings.json
CHANNEL_KILLFEED=
CHANNEL_JOIN_LEAVE=
CHANNEL_GAME_CHAT=
CHANNEL_GAME_EVENTS=
CHANNEL_ADMIN_LOG=
CHANNEL_POP_STATUS=
CHANNEL_WIPE_STATUS=
CHANNEL_TP_LOG=
CHANNEL_REPORTS=

# ——— Group limit (trio = 3) ———
GROUP_MAX_MEMBERS=3

# ——— Teleports ———
TP_ENABLED=true
TP_MAX_HOMES=2
TP_VIP_MAX_HOMES=5
TP_COOLDOWN_SECONDS=300
TP_VIP_COOLDOWN_SECONDS=60
TP_DELAY_SECONDS=10
TP_TPR_ENABLED=true

# ——— VIP sync (Discord ROLE_VIP → in-game kit) ———
# Create a kit with this id in the admin Kits tab
VIP_KIT_ID=vip
# Optional override instead of kit: VIP_RCON_GRANT=inventory.giveto "{ign}" "scrap" 500
VIP_RCON_GRANT=
VIP_RCON_REVOKE=

# ——— Wipe countdown (ISO fallback; panel Overview can override) ———
WIPE_AT=

# ——— Economy ———
ECONOMY_ENABLED=true
ECONOMY_KILL_REWARD=25
ECONOMY_DEATH_PENALTY=5
ECONOMY_PLAYTIME_REWARD=10
ECONOMY_PLAYTIME_MINUTES=30
ECONOMY_STARTING_BALANCE=100

# ——— Server pop (KAOS fallback, unused when RCON is on) ———
SERVER_MAX=100
POP_POLL_MS=30000

ADMIN_USER_IDS=
